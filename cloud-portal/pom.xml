<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.company.cloud</groupId>
        <artifactId>cloud-server</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>cloud-portal</artifactId>
    <name>cloud-portal</name>
    <description>门户接入：《云平台统一门户》产品侧实现（商品目录、幂等开通、b_bill 账单与扣费/退款、每日对账上报）。
        portal_product_sku / portal_provision / b_bill 三表 Owner；users.quota_bytes 由开通授予与到期收回维护。</description>

    <dependencies>
        <dependency>
            <groupId>com.company.cloud</groupId>
            <artifactId>cloud-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- cloud-auth：复用门户 JWT 验签 / 影子用户映射 / CurrentUser / @RequireRole -->
        <dependency>
            <groupId>com.company.cloud</groupId>
            <artifactId>cloud-auth</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <!-- Swagger/OpenAPI 注解（@Tag/@Operation/@Schema）。运行期的 UI 与 /v3/api-docs 由 cloud-app 提供，
             这里只是让本模块的源码能编译注解；版本由根 pom 的 dependencyManagement 统一管理。 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
