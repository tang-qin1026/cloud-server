# =============================================================================
#  cloud-server · 环境变量模板（env.example）
# =============================================================================
#
#  【这是什么】
#  环境变量的「清单 / 样例」，作用只有一个：告诉使用方**有哪些变量、什么含义、缺省值是什么**。
#  它不是运行时真正加载的配置文件，而是一份给人看的说明书。
#
#  【怎么用】
#  复制成实际使用的 env 文件（如 .env）或直接配进部署环境，再把值填成真实值。
#  Spring Boot 按 `${VAR:缺省值}` 读取：设了环境变量就用环境变量，没设才用 application.yml 的缺省值。
#
#  ★★ 本文件会提交进 Git，所以【绝对不能写真实数据】★★
#     · 不写真实密码 / 密钥 / token
#     · 不写真实内网 IP、公网域名、生产库地址
#     · 原因：一旦进了 Git 历史，后面即使删掉也仍能被翻出来，清理成本很高
#
#  ★★ 真实值放哪里 ★★
#     部署环境的环境变量 / 容器 Secret / 密钥管理服务。**永远不要提交到仓库。**
#
#  标注 [必改] 的项：生产环境必须显式配置，不能依赖缺省值。
#  标注 [待平台侧] 的项：需要向平台侧（门户负责人）索取后才能填写。
# =============================================================================


# -----------------------------------------------------------------------------
# 一、数据库（PostgreSQL）
# -----------------------------------------------------------------------------
DB_HOST=localhost                     # [必改] 数据库主机（不要依赖缺省 localhost）
DB_PORT=5432
DB_NAME=cloud
DB_USER=cloud
DB_PASSWORD=change-me                 # [必改] 不要用缺省的 cloud


# -----------------------------------------------------------------------------
# 二、缓存（Redis）—— 限流、token 吊销、用户级 token 版本
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# Redis 未使用密码；若启用，请在此补充并由运维注入（当前代码未读取密码变量）


# -----------------------------------------------------------------------------
# 三、认证与安全（A 组）
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-at-least-32-bytes-long   # [必改] ≥32 字节的随机串；缺省值是开发占位
JWT_ISSUER=cloud-server
JWT_ACCESS_TTL_MINUTES=120
JWT_REFRESH_TTL_DAYS=14
SECURITY_MAX_LOGIN_FAILURES=5
SECURITY_LOCK_MINUTES=15
SECURITY_RATE_LIMIT_PER_MINUTE=5
DEFAULT_QUOTA_BYTES=21474836480               # 新用户默认配额（字节），21474836480 = 20GB


# -----------------------------------------------------------------------------
# 四、对象存储（MinIO）—— 文件上传/下载依赖，未就绪不影响其它接口启动
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=http://minio-host:9000         # [必改] MinIO 服务地址
MINIO_PUBLIC_ENDPOINT=                        # 对外可访问的地址（留空则用 ENDPOINT）
MINIO_ACCESS_KEY=change-me                    # [必改]
MINIO_SECRET_KEY=change-me                    # [必改]
MINIO_BUCKET=cloud-files
MINIO_REGION=us-east-1


# -----------------------------------------------------------------------------
# 五、回收站清理（C 组）
# -----------------------------------------------------------------------------
RECYCLE_RETENTION_DAYS=30
RECYCLE_PURGE_CRON=0 0 3 * * ?
RECYCLE_PURGE_DRY_RUN=true                    # [上线前确认] true=只打印不真删，验收通过后改 false
RECYCLE_PURGE_BATCH_SIZE=200


# -----------------------------------------------------------------------------
# 六、App / EXE 推送更新（分发地址）
# -----------------------------------------------------------------------------
APP_UPDATE_BASE_URL=https://your-domain:port  # [必改] 拼 apkUrl 的对外入口，须与 nginx 下载目录一致
APP_UPDATE_DOWNLOAD_DIR=/cloud/downloads      # 安装包落盘目录（宿主机路径）


# =============================================================================
# 七、统一门户接入（云存储侧）
# =============================================================================
# 三条链路、两套凭证，别混用：
#   ① 用户 → 本产品：门户签发的 JWT（Bearer）
#   ② 门户 → 本产品：请求头 X-Internal-Key
#   ③ 本产品 → 门户：请求头 X-Internal-Key
# 注意：②③ 目前使用的是**同一个** PORTAL_INTERNAL_KEY 值；
#       若平台侧对两个方向下发不同的密钥，需要拆成两个配置项（找后端改）。
# =============================================================================

# ---- 7.1 门户地址与内部密钥 ----
PORTAL_PRODUCT_CODE=storage                   # 本产品在门户侧的产品编码，由门户配置决定，一般不用改
PORTAL_BASE_URL=http://portal-host:3000       # [待平台侧] 门户内网地址（不带尾部斜杠）
PORTAL_INTERNAL_KEY=                          # [必改][待平台侧] 内部调用密钥；**留空则所有 /internal/** 一律 401（fail-closed）**

# ---- 7.2 门户接口路径（默认已与契约一致，路径有变时才改）----
PORTAL_WALLET_DEDUCT_PATH=/api/internal/wallet/deduct
PORTAL_WALLET_REFUND_PATH=/api/internal/wallet/refund
PORTAL_RECONCILIATION_PATH=/api/internal/reconciliation/report

# ---- 7.3 出站调用超时与重试 ----
PORTAL_CONNECT_TIMEOUT_MS=3000
PORTAL_READ_TIMEOUT_MS=10000
# 仅「系统类失败」退避重试；业务码（1002/1004/3001/3002/3004/3005 等）一律不重试。
# 本地联调可缩短，例如 100,100,100
PORTAL_DEDUCT_RETRY_DELAYS_MS=1000,5000,30000

# ---- 7.4 门户 JWT 验签（RS256 + JWKS）----
PORTAL_AUTH_ENABLED=true                      # 关掉则门户令牌一律不认证（仅本系统自签 JWT 可用）
PORTAL_JWKS_URL=http://portal-host:3000/.well-known/jwks.json   # [待平台侧] 裸 JWKS 端点（不套 {code,data}）
PORTAL_ISSUER=cloud-portal                    # 必须匹配门户令牌的 iss
PORTAL_JWKS_REFRESH_HOURS=12                  # 公钥缓存刷新间隔；也是**密钥吊销的最长生效延迟**
PORTAL_JWKS_REFRESH_CRON=0 0 */12 * * *
PORTAL_JWKS_CONNECT_TIMEOUT_MS=3000
PORTAL_JWKS_READ_TIMEOUT_MS=5000

# ---- 7.5 门户影子用户（首达建档）----
PORTAL_SHADOW_USERNAME_PREFIX=portal_         # 影子用户名 = 前缀 + 门户用户 UUID
PORTAL_SHADOW_DEFAULT_QUOTA_BYTES=21474836480
PORTAL_SHADOW_PASSWORD_HASH=!portal-shadow-no-local-login   # 刻意写非法 bcrypt 串，禁止影子用户本地登录

# ---- 7.6 订阅状态机（到期 → 宽限 → 停机）----
PORTAL_SUBSCRIBE_GRACE_DAYS=7
PORTAL_EXPIRE_CRON=0 0 4 * * *

# ---- 7.7 账单对账上报 ----
PORTAL_RECONCILE_CRON=0 0 6 * * *             # 默认每日 06:00 上报前一日账单
PORTAL_RECONCILE_RETRIES=3                    # 对账上报幂等，系统类失败可直接重试

# ---- 7.8 按量计费（billing_mode=2）后付出账 ----
PORTAL_POSTPAID_ENABLED=false                 # [需业务确认] 计价口径未定义前保持关闭
PORTAL_POSTPAID_CRON=0 30 5 * * *
PORTAL_POSTPAID_BATCH_SIZE=200


# =============================================================================
# 附：本模板的结构说明
# =============================================================================
# · 变量名与 cloud-app/src/main/resources/application.yml 中的 ${VAR:缺省值} 一一对应；
#   新增配置项时请同时更新 application.yml 与本文件，避免文档与代码脱节。
# · 本文件只写「占位/缺省值」，真实值由部署环境注入。
#
# 【已知待改进】application.yml 的两个缺省值目前带了真实环境信息，建议改为占位：
#   · MINIO_ENDPOINT     缺省为内网 MinIO 地址，建议改为 http://minio-host:9000 或留空
#   · APP_UPDATE_BASE_URL 缺省为对外 IP+端口，建议改为 https://your-domain:port 或留空
#   这两项与「不把真实数据写进仓库」的原则冲突，且改缺省值可能影响既有部署，故先记录不改。
