# =============================================================================
#  cloud-server · 环境变量模板（env.example）
# =============================================================================
#
#  【这是什么】
#  环境变量的「清单 / 样例」，作用只有一个：告诉使用方有哪些变量、什么含义、缺省值是什么。
#  它不是运行时会自动加载的配置文件，而是一份给人看的说明书。
#
#  【怎么用：三步】
#    1) 复制模板：cp env.example .env
#    2) 把 .env 里的占位值改成真实值（至少填标 [必改] 的项）
#    3) 启动时显式导入这个文件（Spring Boot 不会自动读 .env）：
#
#         cd <仓库根目录>
#         java -jar cloud-app/target/cloud-app-0.0.1-SNAPSHOT.jar \
#              --server.port=3001 \
#              --spring.config.import=optional:file:./.env[.properties]
#
#       要点：
#         · 必须【在仓库根目录】启动，相对路径 ./.env 才解析得到
#         · [.properties] 是扩展名提示，告诉 Spring 按 properties 格式解析这个没有标准后缀的文件
#         · 前缀 optional: 表示文件不存在也不报错；本地联调建议先用【不带 optional】跑一次，
#           让配置错误直接暴露出来，确认无误后再加回 optional（否则配置没生效会被静默吞掉）
#
#  【格式硬要求】本文件按 Java properties 解析，违反会导致值被污染：
#    · 注释必须【独占一行】。绝不要写成 `KEY=value  # 说明` —— 井号后面会被当成值的一部分
#    · 不要写 export，不要给值加引号
#    · 文件不能带 UTF-8 BOM（否则第一个变量名会被污染）
#    · KEY、=、value 之间不要加空格
#
#  ★★ 本文件会提交进 Git，所以【绝对不能写真实数据】★★
#     · 不写真实密码 / 密钥 / token
#     · 不写真实内网 IP、公网域名、生产库地址
#     · 原因：一旦进了 Git 历史，后面即使删掉也仍能被翻出来，清理成本很高
#
#  ★★ 真实值放哪里 ★★
#     本地：.env（已被 .gitignore 忽略，可放心填真实值）
#     线上：部署环境的环境变量 / 容器 Secret / 密钥管理服务。永远不要提交到仓库。
#
#  标注 [必改]      ：生产环境必须显式配置，不能依赖缺省值
#  标注 [待平台侧]  ：需向平台侧（门户负责人）索取后才能填写
# =============================================================================


# -----------------------------------------------------------------------------
# 一、数据库（PostgreSQL）
# -----------------------------------------------------------------------------

# [必改] 数据库主机（不要依赖缺省 localhost）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloud
DB_USER=cloud

# [必改] 不要用缺省的 cloud
DB_PASSWORD=change-me


# -----------------------------------------------------------------------------
# 二、缓存（Redis）—— 限流、token 吊销、用户级 token 版本
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# 当前代码未读取 Redis 密码变量；若启用鉴权请由运维在部署层补充


# -----------------------------------------------------------------------------
# 三、认证与安全（A 组）
# -----------------------------------------------------------------------------

# [必改] ≥32 字节的随机串；缺省值是开发占位，不可用于生产
JWT_SECRET=change-me-at-least-32-bytes-long

JWT_ISSUER=cloud-server
JWT_ACCESS_TTL_MINUTES=120
JWT_REFRESH_TTL_DAYS=14
SECURITY_MAX_LOGIN_FAILURES=5
SECURITY_LOCK_MINUTES=15
SECURITY_RATE_LIMIT_PER_MINUTE=5

# 新用户默认配额（字节）。21474836480 = 20GB
DEFAULT_QUOTA_BYTES=21474836480


# -----------------------------------------------------------------------------
# 四、对象存储（MinIO）—— 文件上传/下载依赖；未就绪不影响其它接口启动
# -----------------------------------------------------------------------------

# [必改] MinIO 服务地址
MINIO_ENDPOINT=http://minio-host:9000

# 对外可访问的地址；留空则用 MINIO_ENDPOINT
MINIO_PUBLIC_ENDPOINT=

# [必改]
MINIO_ACCESS_KEY=change-me

# [必改]
MINIO_SECRET_KEY=change-me

MINIO_BUCKET=cloud-files
MINIO_REGION=us-east-1


# -----------------------------------------------------------------------------
# 五、回收站清理（C 组）
# -----------------------------------------------------------------------------
RECYCLE_RETENTION_DAYS=30
RECYCLE_PURGE_CRON=0 0 3 * * ?

# [上线前确认] true=只打印不真删；验收通过后再改 false
RECYCLE_PURGE_DRY_RUN=true

RECYCLE_PURGE_BATCH_SIZE=200


# -----------------------------------------------------------------------------
# 六、App / EXE 推送更新（分发地址）
# -----------------------------------------------------------------------------

# [必改] 拼 apkUrl 的对外入口，须与 nginx 下载目录一致
APP_UPDATE_BASE_URL=https://your-domain:port

# 安装包落盘目录（宿主机路径）
APP_UPDATE_DOWNLOAD_DIR=/cloud/downloads


# =============================================================================
# 七、统一门户接入（云存储侧）
# =============================================================================
# 三条链路、两套凭证，别混用：
#   ① 用户 → 本产品：门户签发的 JWT（Bearer）
#   ② 门户 → 本产品：请求头 X-Internal-Key
#   ③ 本产品 → 门户：请求头 X-Internal-Key
#
# 注意：②③ 目前使用的是【同一个】PORTAL_INTERNAL_KEY 值。
#       若平台侧对两个方向下发不同的密钥，需拆成两个配置项（找后端改）。
# =============================================================================

# ---- 7.1 门户地址与内部密钥 ----

# 本产品在门户侧的产品编码，由门户配置决定，一般不用改
PORTAL_PRODUCT_CODE=storage

# [必改][待平台侧] 门户内网地址（不带尾部斜杠）
PORTAL_BASE_URL=http://portal-host:3000

# [必改][待平台侧] 内部调用密钥
# 留空则所有 /internal/** 一律 401（fail-closed，刻意设计，避免接口裸奔）
PORTAL_INTERNAL_KEY=


# ---- 7.2 门户接口路径（默认已与契约一致，路径有变时才改）----
PORTAL_WALLET_DEDUCT_PATH=/api/internal/wallet/deduct
PORTAL_WALLET_REFUND_PATH=/api/internal/wallet/refund
PORTAL_RECONCILIATION_PATH=/api/internal/reconciliation/report


# ---- 7.3 出站调用超时与重试 ----
PORTAL_CONNECT_TIMEOUT_MS=3000
PORTAL_READ_TIMEOUT_MS=10000

# 仅「系统类失败」退避重试；业务码（1002/1004/3001/3002/3004/3005 等）一律不重试。
# 本地联调可缩短为 100,100,100
PORTAL_DEDUCT_RETRY_DELAYS_MS=1000,5000,30000


# ---- 7.4 门户 JWT 验签（RS256 + JWKS）----

# 关掉则门户令牌一律不认证（仅本系统自签 JWT 可用）
PORTAL_AUTH_ENABLED=true

# [待平台侧] 裸 JWKS 端点，不套 {code,data} 信封
PORTAL_JWKS_URL=http://portal-host:3000/.well-known/jwks.json

# 必须匹配门户令牌的 iss
PORTAL_ISSUER=cloud-portal

# 公钥缓存刷新间隔；同时也是【密钥吊销的最长生效延迟】
PORTAL_JWKS_REFRESH_HOURS=12

PORTAL_JWKS_REFRESH_CRON=0 0 */12 * * *
PORTAL_JWKS_CONNECT_TIMEOUT_MS=3000
PORTAL_JWKS_READ_TIMEOUT_MS=5000


# ---- 7.5 门户影子用户（首达建档）----

# 影子用户名 = 本前缀 + 门户用户 UUID
PORTAL_SHADOW_USERNAME_PREFIX=portal_

PORTAL_SHADOW_DEFAULT_QUOTA_BYTES=21474836480

# 刻意写非法 bcrypt 串，使影子用户无法从本系统登录入口登录
PORTAL_SHADOW_PASSWORD_HASH=!portal-shadow-no-local-login


# ---- 7.6 订阅状态机（到期 → 宽限 → 停机）----
PORTAL_SUBSCRIBE_GRACE_DAYS=7
PORTAL_EXPIRE_CRON=0 0 4 * * *


# ---- 7.7 账单对账上报 ----

# 默认每日 06:00 上报前一日账单
PORTAL_RECONCILE_CRON=0 0 6 * * *

# 对账上报幂等，系统类失败可直接重试
PORTAL_RECONCILE_RETRIES=3


# ---- 7.8 按量计费（billing_mode=2）后付出账 ----

# [需业务确认] 计价口径未定义前保持关闭
PORTAL_POSTPAID_ENABLED=false

PORTAL_POSTPAID_CRON=0 30 5 * * *
PORTAL_POSTPAID_BATCH_SIZE=200


# =============================================================================
# 附：维护说明
# =============================================================================
# · 变量名与 cloud-app/src/main/resources/application.yml 中的 ${VAR:缺省值} 一一对应；
#   新增配置项时请同时更新 application.yml 与本文件，避免文档与代码脱节。
# · 本文件只写「占位/缺省值」，真实值由本地 .env 或线上环境变量注入。
#
# 【已知待改进】application.yml 的两个缺省值目前带了真实环境信息，建议改为占位：
#   · MINIO_ENDPOINT      缺省为内网 MinIO 地址，建议改为 http://minio-host:9000 或留空
#   · APP_UPDATE_BASE_URL 缺省为对外 IP+端口，建议改为 https://your-domain:port 或留空
#   这两项与「不把真实数据写进仓库」的原则冲突；改缺省值可能影响既有部署，故先记录不改。
